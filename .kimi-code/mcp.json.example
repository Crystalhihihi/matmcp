{
  "mcpServers": {
    "matmcp": {
      "command": "wsl",
      "args": [
        "-d", "Ubuntu", "--", "bash", "-lc",
        "source ~/miniforge3/etc/profile.d/conda.sh && conda activate matmcp && cd /mnt/d/YOUR-REPO-PATH && exec python -m matmcp.server"
      ],
      "startupTimeoutMs": 60000,
      "toolTimeoutMs": 7200000
    }
  }
}
